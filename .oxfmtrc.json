{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": true,
  "semi": false,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "arrowParens": "avoid",
  "sortImports": true,
  "sortPackageJson": true,
  "ignorePatterns": ["dist/**", "coverage/**", "docs/**/*.md", "node_modules/**", "pnpm-lock.yaml", "vendor/**"]
}
